{
  "manifest_version": 3,
  "name": "Antigravity Enterprise DLP",
  "version": "1.0",
  "description": "Intercepts web uploads and enforces Data Loss Prevention policies.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
